[Unit]
Description=Pi Web private scientific computation broker
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/pi-web-science/worker.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=pi-web-science
RuntimeDirectoryMode=0700
TemporaryFileSystem=/run/pi-web-science/work:rw,nosuid,nodev,noexec,size=192m,mode=0700
UMask=0077
KillMode=control-group

[Install]
WantedBy=multi-user.target
