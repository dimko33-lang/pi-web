{
  "format": 1,
  "optionalRoots": [
    "opt/curvelab-editor", "etc/curvelab-editor.env", "etc/systemd/system/curvelab-editor.service",
    "etc/curvelab-route", "etc/pi-web-speech"
  ],
  "projects": {
    "nikita": [
      "srv/pi-workspaces/nikita",
      "opt/tg-agent",
      "opt/workspace-branding/nikita.js",
      "opt/pi-web-runtime/package.json",
      "opt/pi-web-runtime/package-lock.json",
      "usr/local/bin/node"
    ],
    "reader-archives": [
      "opt/projects",
      "opt/nikita-debri-archive",
      "opt/nikita-lightcone-archive",
      "var/lib/nikita-live-archive"
    ],
    "salon": [
      "var/lib/nikita-publications",
      "var/lib/nikita-salon-history",
      "var/lib/nikita-salon-piwep",
      "usr/local/lib/nikita-salon-history.py",
      "usr/local/lib/nikita-salon-piwep.py"
    ],
    "tools": [
      "opt/nikita-image",
      "var/lib/nikita-image",
      "opt/nikita-web",
      "opt/nikita-science"
    ],
    "app-platform": [
      "opt/nikita-project-runtime", "opt/nikita-reader-ui", "usr/local/bin/nikita-project", "etc/pi-web-instance"
    ],
    "website-roots": [
      "var/www"
    ],
    "managed-projects": [
      "srv/nikita-projects"
    ],
    "routing": [
      "etc/nginx/conf.d",
      "etc/nginx/sites-available",
      "etc/nginx/sites-enabled",
      "etc/nginx/snippets",
      "etc/nginx/nginx.conf"
    ],
    "maintenance": [
      "etc/polkit-1/rules.d/49-nikita-maintenance.rules",
      "usr/local/lib/nikita-home-save.py",
      "etc/nikita-home-save"
    ],
    "nikita-project-runner": [
      "etc/nikita-project-route/upstream.conf",
      "etc/systemd/system/nikita-project-runner@.service",
      "etc/systemd/system/nikita-project-runner.socket",
      "etc/systemd/system/nikita-project-deps@.service",
      "etc/systemd/system/nikita-project-deps.socket",
      "etc/systemd/system/srv-nikita\\x2dprojects-workspace.mount",
      "usr/local/lib/nikita-project-relay.cjs",
      "usr/local/lib/nikita-project-http-relay.cjs",
      "usr/local/lib/nikita-project-deps.py",
      "usr/local/lib/nikita-project-release.py",
      "usr/local/lib/nikita-project-runner.py"
    ],
    "browser-admin": [
      "srv/pi-workspaces/browser",
      "usr/local/sbin/pi-web-launch",
      "etc/sudoers.d/pi-browser-launch",
      "var/lib/pi-browser-admin"
    ]
  }
}
