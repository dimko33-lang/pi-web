[Unit]
Description=Fixed isolated scientific computation broker for Nikita
Requires=docker.service var-lib-nikita\x2dscience-work.mount
After=docker.service var-lib-nikita\x2dscience-work.mount
[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nikita-science
ExecStart=/usr/bin/python3 -I /opt/nikita-science/worker.py
ExecStopPost=/usr/bin/python3 -I /opt/nikita-science/worker.py --cleanup
RuntimeDirectory=nikita-science
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
ReadWritePaths=/run/nikita-science /var/lib/nikita-science/work
InaccessiblePaths=-/srv/pi-workspaces -/root -/home -/opt/tg-agent -/opt/nikita-web -/etc/pi-web.env -/etc/curvelab-editor.env -/etc/site-entry.json
MemoryMax=384M
CPUQuota=100%
TasksMax=48
TimeoutStopSec=45
[Install]
WantedBy=multi-user.target
