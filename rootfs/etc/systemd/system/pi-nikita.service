[Unit]
Description=Isolated Nikita pi-web
After=network.target

[Service]
Type=simple
User=pi-nikita
Group=pi-nikita
Slice=pi-nikita.slice
WorkingDirectory=/srv/pi-workspaces/nikita/rootfs/opt/pi-web
Environment=HOME=/srv/pi-workspaces/nikita/rootfs/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/pi-browsers
Environment=CHROMIUM_PATH=/opt/pi-browsers/chromium-1248/chrome-linux64/chrome
Environment=PORT=5670
Environment=PI_WEB_PI_BIN=/opt/pi-web-runtime/node_modules/.bin/pi
Environment=PI_WEB_AGENT_ROOT=/srv/pi-workspaces/nikita/rootfs/opt/projects
Environment=PI_WEB_SESSIONS_DIR=/srv/pi-workspaces/nikita/rootfs/opt/pi-web/sessions
Environment=PI_WEB_ALLOWED_HOSTS=@@FORMER_PANEL_HOST@@
Environment=PI_WEB_TOOL_ENVIRONMENT=/srv/pi-workspaces/nikita/rootfs/opt/ENVIRONMENT.md
EnvironmentFile=/srv/pi-workspaces/nikita/rootfs/etc/pi-web.env
ExecStart=/usr/local/bin/node --import tsx server/main.ts
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
UMask=0077
ReadWritePaths=/srv/pi-workspaces/nikita/rootfs/opt/projects /srv/pi-workspaces/nikita/rootfs/root /srv/pi-workspaces/nikita/rootfs/opt/pi-web/data /srv/pi-workspaces/nikita/rootfs/opt/pi-web/sessions
InaccessiblePaths=-/srv/pi-workspaces/arri -/srv/pi-workspaces/eritcya -/srv/pi-workspaces/curvelab -/srv/pi-workspaces/owner -/root -/opt/pi-web -/opt/curvelab-editor -/opt/projects -/opt/aeronav-deployment -/opt/aeronav-test-env -/var/www/aeronav -/var/lib/server-backup -/etc/pi-web.env -/etc/curvelab-editor.env -/etc/site-entry.json -/srv/pi-workspaces/aeronav

[Install]
WantedBy=multi-user.target
