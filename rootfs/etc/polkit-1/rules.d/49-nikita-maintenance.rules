// Permit this Unix user to maintain ONLY its own Telegram service.
polkit.addRule(function(action, subject) {
 if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "pi-nikita") return;
 var unit = action.lookup("unit"), verb = action.lookup("verb");
 if (unit === "tg-agent.service" && ["start", "stop", "restart"].indexOf(verb) >= 0) return polkit.Result.YES;
 if (unit === "nikita-restart.service" && verb === "start") return polkit.Result.YES;
});
