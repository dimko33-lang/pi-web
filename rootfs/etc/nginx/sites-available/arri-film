server {
 listen 80; listen [::]:80;
 server_name @@ARRI_HOST@@;
 access_log off;
 location ^~ /.well-known/acme-challenge/ {root /var/www/instance-site-acme;}
 location / {return 301 https://@@ARRI_HOST@@$request_uri;}
}
server {
 listen 443 ssl; listen [::]:443 ssl;
 server_name @@ARRI_HOST@@;
 ssl_certificate /etc/letsencrypt/live/arri-curvelab-ru/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/arri-curvelab-ru/privkey.pem;
 root /srv/nikita-projects/arri/public;
 index index.html;
 disable_symlinks on;
 autoindex off;
 access_log off;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 add_header Cache-Control "no-cache" always;
 location ~ /\. {return 404;}
 location / {limit_except GET {deny all;} try_files $uri $uri/ =404;}
}
