server {
 listen 80; listen [::]:80;
 server_name @@EDITOR_HOST@@ @@EDITOR_WWW@@;
 access_log off;
 location ^~ /.well-known/acme-challenge/ { root /var/www/instance-site-acme; }
 location / { return 301 https://$host$uri; }
}
server {
 listen 443 ssl; listen [::]:443 ssl;
 server_name @@EDITOR_HOST@@;
 ssl_certificate /etc/letsencrypt/live/curvelab-ru/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/curvelab-ru/privkey.pem;
 access_log off;
 add_header Referrer-Policy no-referrer always;
 client_max_body_size 24m;
 location / { include /etc/curvelab-route/upstream.conf; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-For $remote_addr; proxy_buffering off; proxy_read_timeout 3600s; }
}

server {
 listen 443 ssl; listen [::]:443 ssl; server_name @@EDITOR_WWW@@;
 ssl_certificate /etc/letsencrypt/live/curvelab-ru/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/curvelab-ru/privkey.pem;
 access_log off; return 301 https://@@EDITOR_HOST@@$request_uri;
}
